class Solution:
    def isAnagram(self, s: str, t: str) -> bool:

        if len(s) != len(t):
            return False

        s =sorted(s)
        t = sorted(t)
        n =len(s)

        for i in range (n):
            if s[i] != t[i]:
                return False
                
        return True    






class Solution:
    def isAnagram(self, s: str, t: str) -> bool:

        if len(s) != len(t):
            return False

        count ={}

        for ch in s:
            count [ch] = count.get(ch,0)+1

        for ch in t:
            if ch  not in count:
                return False
            count[ch] -=1


            if count[ch]<0:
                return False
        
        return True

        
          
        

        
          
        