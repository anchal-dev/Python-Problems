'''
class node:
    def __init__(data):
        self.data = data
        self.next = None
'''

class Solution:
    def getMiddle(self, head):
        # code here
        fastptr = head
        slowptr = head
        
        
        
        while fastptr is not None and fastptr.next is not None:
            
            slowptr = slowptr.next
            fastptr = fastptr.next.next
        
        return slowptr.data