class Solution:
    def rearrangeArray(self, nums: List[int]) -> List[int]:
        neg =1
        pos=0
        ans = [0]*len(nums)

        for num in nums:
            if num>0:
                ans[pos] = num
                pos =pos+2

            else:
                ans[neg]  = num
                neg =  neg+2

        return ans

